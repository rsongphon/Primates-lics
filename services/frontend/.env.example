# Frontend Environment Variables
# Copy this file to .env.local for local development

# =================================================================
# API Gateway Configuration (Kong)
# =================================================================
# Main API URL - Routes through Kong API Gateway
NEXT_PUBLIC_API_URL=http://localhost:8080

# WebSocket URL - Routes through Kong API Gateway
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# =================================================================
# Direct Backend URLs (for debugging/bypass)
# =================================================================
# Use these to bypass Kong and connect directly to backend services
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8001

# =================================================================
# Production Configuration Example
# =================================================================
# For production, set these to your actual domain:
# NEXT_PUBLIC_API_URL=https://api.lics.example.com
# NEXT_PUBLIC_WS_URL=wss://api.lics.example.com

# =================================================================
# Additional Configuration
# =================================================================
# Add any additional frontend-specific environment variables here
